{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/admin/products/:action",
      "destination": "/api/admin/products?action=:action"
    },
    {
      "source": "/api/admin/products",
      "destination": "/api/admin/products"
    },
    {
      "source": "/api/admin/shiprocket-retry",
      "destination": "/api/admin/orders"
    },
    {
      "source": "/api/blog/post",
      "destination": "/api/blog/posts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/public/(.*)",
      "destination": "/frontend/public/$1"
    },
    {
      "source": "/products",
      "destination": "/frontend/shop.html"
    },
    {
      "source": "/products/(.*)",
      "destination": "/frontend/products/index.html"
    },
    {
      "source": "/blog",
      "destination": "/frontend/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog/render?slug=:slug"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/api/blog/render?slug=$1"
    },
    {
      "source": "/collections/(.*)",
      "destination": "/frontend/shop"
    },
    {
      "source": "/",
      "destination": "/frontend/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/frontend/$1"
    }
  ],
  "functions": {
    "api/admin/orders.js": {
      "includeFiles": "backend/src/**"
    },
    "api/payments/**": {
      "includeFiles": "backend/src/**"
    },
    "api/orders/**": {
      "includeFiles": "backend/src/**"
    },
    "api/shiprocket/**": {
      "includeFiles": "backend/src/**"
    }
  }
}
