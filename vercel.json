{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/public/(.*)",
      "destination": "/frontend/public/$1"
    },
    {
      "source": "/products/:slug*",
      "destination": "/frontend/product/detail.html"
    },
    {
      "source": "/collections/:category*",
      "destination": "/frontend/shop.html"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/frontend/$1"
    }
  ],
  "functions": {
    "api/**": {
      "includeFiles": "backend/**"
    }
  }
}
