{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/public/(.*)",
      "destination": "/frontend/public/$1"
    },
    {
      "source": "/products",
      "destination": "/frontend/products/index"
    },
    {
      "source": "/products/(.*)",
      "destination": "/frontend/products/index"
    },
    {
      "source": "/blog",
      "destination": "/frontend/blog"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/frontend/blog/index"
    },
    {
      "source": "/collections/(.*)",
      "destination": "/frontend/shop"
    },
    {
      "source": "/",
      "destination": "/frontend/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/frontend/$1"
    }
  ],
  "functions": {
    "api/**": {
      "includeFiles": "backend/**"
    }
  }
}
